{
    "endPoint": {
        "url": "https://ollama.com/v1/chat/completions",
        "protocol": "ollama-completions",
        "apiKeyEnv": "OLLAMA_API_KEY",
        "model": "glm-5.1"
    },
    "systemPrompt": "You are a helpful assistant.",
    "currentDirectory": "../../../arc80",
    "permissions": [
        {
            "path": ".",
            "tools": ["read", "list_dir", "find_in_files", "write", "edit"]
        },
        {
            "path": "../plywood",
            "tools": ["read", "list_dir", "find_in_files"]
        }
    ]
}
